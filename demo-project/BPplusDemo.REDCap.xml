	<ItemDef OID="bpplus_xml_text" Name="bpplus_xml_text" DataType="text" Length="999" redcap:Variable="bpplus_xml_text" redcap:FieldType="text" redcap:FieldNote="With file storage on this holds a marker -- the size, hash and document id of the recording that was filed. With file storage off, or when filing failed, it holds the recording itself, reduced to fit: a text field takes 65,535 bytes and a full result is larger, so the choice is reduced or truncated, and a document cut off mid-element is worth nothing. A value beginning with &quot;&lt;&quot; is a recording; anything else is a marker." redcap:SectionHeader="The result file from the device" redcap:FieldAnnotation="@HIDDEN-SURVEY">
		<Question><TranslatedText>Recording status, or the reduced recording</TranslatedText></Question>
